# /etc/fstab: static file system information.
#
# noatime turns off atimes for increased performance (atimes normally aren't 
# needed); notail increases performance of ReiserFS (at the expense of storage 
# efficiency).  It's safe to drop the noatime options if you want and to 
# switch between notail / tail freely.
#
# The root filesystem should have a pass number of either 0 or 1.
# All other filesystems should have a pass number of 0 or greater than 1.
#
# See the manpage fstab(5) for more information.
#

# <fs>			<mountpoint>	<type>		<opts>		<dump/pass>

# NOTE: If your BOOT partition is ReiserFS, add the notail option to opts.
#
# NOTE: Even though we list ext4 as the type here, it will work with ext2/ext3
#       filesystems.  This just tells the kernel to use the ext4 driver.
#
# NOTE: You can use full paths to devices like /dev/sda3, but it is often
#       more reliable to use filesystem labels or UUIDs. See your filesystem
#       documentation for details on setting a label. To obtain the UUID, use
#       the blkid(8) command.

#LABEL=boot		/boot		ext4		noauto,noatime	1 2
#UUID=58e72203-57d1-4497-81ad-97655bd56494		/		ext4		noatime		0 1
#LABEL=swap		none		swap		sw		0 0
#/dev/cdrom		/mnt/cdrom	auto		noauto,ro	0 0

UUID=f638ce3e-1330-4857-a003-30cd41640bb8   /boot   ext4    noauto,noatime    0 0
#UUID=4f0c560d-ab43-48e7-ab2e-f05944c2f334   none    swap    sw                  0 0
UUID=8a38c940-278e-4c5c-8f60-1ff6b47b8943   /       ext4    noatime             0 0
#UUID=b1f31028-aba4-4f67-a22e-595573498c1f   /home/g ext4    defaults,noatime		0 0

#UUID=264426AE15CFD289                       /mnt/ext    ntfs    noauto,defaults,noatime,gid=1000,uid=1000  0 0
UUID=1DB900987CEBE2F2                       /mnt/hd1    ntfs    defaults,noatime,gid=1000,uid=1000  0 0
UUID=0bc8eecf-03cb-41e3-b263-3178679af56b   /mnt/hd2	ext4	defaults,noatime 0 0
tmpfs                                       /var/tmp/portage    tmpfs   size=32G,uid=portage,gid=portage,mode=775,nosuid,noatime,nodev  0 0
